# Copy this file to .env and fill in real values.
# .env is gitignored — this example file is NOT, so it documents every variable.

# Application
ENVIRONMENT=local

# Security (generate a real one: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=change-me-in-local-only

# Database (used from Step 2 onward)
DATABASE_URL=postgresql+asyncpg://teamflow:teamflow@localhost:5432/teamflow

# Redis (used from V3 onward)
# REDIS_URL=redis://localhost:6379/0
